{
  "name": "pocket-strike",
  "version": "1.0.0",
  "description": "A touch-first 2D bowling game built with Excalibur",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "node tools/sim/scoring.test.ts && node tools/sim/settle.ts",
    "sim:pinfall": "node tools/sim/pinfall.ts",
    "sim:balance": "node tools/sim/run-balance.ts"
  },
  "dependencies": {
    "excalibur": "^1.0.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18"
  }
}
