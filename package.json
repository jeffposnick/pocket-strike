{
  "name": "pocket-strike",
  "version": "1.0.0",
  "description": "A touch-first 2D bowling game built with Excalibur",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "node tools/sim/scoring.test.ts && node tools/sim/settle.ts",
    "sim:pinfall": "node tools/sim/pinfall.ts",
    "sim:balance": "node tools/sim/run-balance.ts"
  },
  "dependencies": {
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "excalibur": "^1.0.1"
  },
  "devDependencies": {
    "@vite-pwa/workbox-swkit": "^8.0.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18"
  }
