{
  "name": "pocket-strike",
  "version": "1.0.0",
  "private": true,
  "description": "A touch-first 2D bowling game built with Excalibur",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node tools/sim/scoring.test.ts && node tools/sim/swing.test.ts && node tools/sim/flick.test.ts && node tools/sim/audio.test.ts && node tools/sim/settle.ts",
    "sim:pinfall": "node tools/sim/pinfall.ts",
    "sim:balance": "node tools/sim/run-balance.ts"
  },
  "dependencies": {
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "excalibur": "^1.0.1"
  },
  "devDependencies": {
    "@vite-pwa/workbox-build": "^8.0.15",
    "@vite-pwa/workbox-swkit": "^8.0.15",
    "@vite-pwa/workbox-window": "^8.0.15",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=22.18"
  }
}
